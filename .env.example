MYSQL_DATABASE=camarao
MYSQL_USER=camarao
# Copie para .env e gere senhas locais antes de subir o Compose.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_PORT=8080
WEB_PORT=5173
FALLBACK_MAIL=
# URL pública do app e SMTP para recuperação. Resend usa usuário resend e chave API na senha.
APP_PUBLIC_URL=http://localhost:5173
# Compose: backend restrito ao Nginx que sobrescreve X-Real-IP. Use false se o backend for exposto diretamente.
APP_TRUST_LOGIN_PROXY=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false
